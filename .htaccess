# Used when the whole project is uploaded into the web root (InfinityFree htdocs, XAMPP htdocs).
# Only /public is reachable; every other folder returns 403.
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(app|config|database|resources|routes|storage|tests|tools|vendor|docs|build)(/|$) - [F,L]
RewriteRule ^(composer\.(json|lock)|README\.md|\.git.*)$ - [F,L]
RewriteRule ^$ public/ [L]
RewriteRule ^((?!public/).*)$ public/$1 [L]
